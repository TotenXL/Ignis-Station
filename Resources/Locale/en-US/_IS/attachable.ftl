# Slot names
is-attachable-slot-generic = attachment
is-attachable-slot-barrel = barrel
is-attachable-slot-rail = rail
is-attachable-slot-stock = stock
is-attachable-slot-underbarrel = underbarrel

# Interaction
is-attachable-verb-detach = Detach {THE($attachable)}
is-attachable-slot-occupied = There's already something in that slot.
is-attachable-toggle-fail-detached = {CAPITALIZE(THE($attachable))} has to be attached to something first.
is-attachable-toggle-fail-unwielded = You need both hands on the weapon for that.

# Examine
is-attachable-examine-empty = The [color=cyan]{$slot}[/color] slot is empty.
is-attachable-examine-filled = {CAPITALIZE(THE($attachable))} is fitted to the [color=cyan]{$slot}[/color] slot.

# Toggle popups
is-attachable-popup-activate = You switch on {THE($attachable)}.
is-attachable-popup-deactivate = You switch off {THE($attachable)}.
is-attachable-popup-deploy = You deploy {THE($attachable)}.
is-attachable-popup-undeploy = You fold up {THE($attachable)}.
is-attachable-popup-extend = You extend {THE($attachable)}.
is-attachable-popup-collapse = You collapse {THE($attachable)}.

# Examine lines for individual attachments
is-attachable-examine-extended-barrel = Improves accuracy and muzzle velocity, at the cost of a slower ready-up.
is-attachable-examine-extended-compensator = Improves accuracy and tames recoil, but the vented gas costs it a little punch.
is-attachable-examine-barrel-charger = Hits noticeably harder, but slows the rate of fire.
is-attachable-examine-suppressor = Muffles the report and hides the muzzle flash.
is-attachable-examine-bayonet = A blade fixed under the barrel. Good for stabbing, and for levering doors open.
is-attachable-examine-red-dot = A simple reflex dot. Steadies aim when shouldered.
is-attachable-examine-reflex = A wide-window reflex sight. Tightens groupings, especially in bursts.
is-attachable-examine-scope = A magnified optic. Lets you see further down your line of fire when shouldered.
is-attachable-examine-miniscope = A compact optic. A little extra reach without weighing the weapon down.
is-attachable-examine-rail-flashlight = A weapon light clamped to the top rail.
is-attachable-examine-magnetic-harness = Lets the weapon sling itself, at a small cost to handling.
is-attachable-examine-angled-grip = Gets the weapon up and on target faster, though it makes it bulkier.
is-attachable-examine-vertical-grip = Steadies the weapon considerably when shouldered, and gets in the way otherwise.
is-attachable-examine-laser-sight = A targeting laser. Helps most when firing one-handed.
is-attachable-examine-gyro-stabilizer = Makes hip fire far more controllable, at the cost of rate of fire.
is-attachable-examine-flashlight-grip = A foregrip with a light built into it.
is-attachable-examine-bipod = Deploys to brace the weapon. Dramatically steadier, until you move.
is-attachable-examine-stock-solid = A fixed stock. Heavy, but it soaks up recoil.
is-attachable-examine-stock-collapsible = A folding stock. Extend it for control, collapse it to keep the weapon compact.
